# QMD local index — rebuildable from the markdown, do not commit
.qmd/index.sqlite
.qmd/index.sqlite-*
.qmd/cache/

# QMD models live in ~/.cache/qmd/models, but guard against stray copies
*.gguf

# sources/ IS tracked on purpose — it is the channel by which raw material
# reaches the companion, and the provenance target for codex `sources:` links.
# Only exclude the genuinely unhelpful.
sources/**/*.tmp
sources/**/~$*
sources/**/*.lock

# Local agent state
.claude/settings.local.json

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
